# Copy to .env for local development (loaded by the server if present; the
# real environment always wins).

# TubeArchivist instance and API token (Settings → user).
TA_URL=http://localhost:8000
TA_TOKEN=

# Postgres (docker compose up -d).
DATABASE_URL=postgres://archive:archive@localhost:5432/archive?sslmode=disable

# OIDC (Authorization Code + PKCE clients). Skip both with AUTH_DISABLED=true.
OIDC_ISSUER=
OIDC_CLIENT_ID=
AUTH_DISABLED=true

# Comma-separated emails that see /healthz details.
ADMIN_EMAILS=

# HMAC secret for the flimm_media cookie (any long random string).
MEDIA_TOKEN_SECRET=change-me

# Browser-facing URL; used for the cookie's Secure flag and CORS.
PUBLIC_URL=http://localhost:5173

# Derived media (audio renditions and the HLS video renditions). The default
# cache dir is a temp dir; one HLS rendition of a 1080p hour is ~2-3 GB, and a
# 2160p HEVC one ~6-8 GB. MEDIA_TRANSCODE_JOBS caps concurrent transcodes
# across every video and every height.
# MEDIA_CACHE_DIR=/tmp/flimm-media
# MEDIA_CACHE_MAX_BYTES=5368709120
# MEDIA_TRANSCODE_JOBS=1
# FFMPEG_PATH=ffmpeg

# An HLS playlist is complete from the first request, so a player may ask for a
# segment the encoder has not reached: MEDIA_SEGMENT_WAIT is how many seconds
# that request waits before the client is told to come back, and
# MEDIA_SEEK_AHEAD_SEGMENTS is how far ahead (in 4-second segments) a request
# has to be before the transcode is re-aimed at it.
# MEDIA_SEGMENT_WAIT=60
# MEDIA_SEEK_AHEAD_SEGMENTS=30

# Hardware transcoding (Intel VAAPI). auto uses the GPU when the render node is
# there and this process can open it, and the CPU otherwise; vaapi always tries
# it; off never does. A failed hardware attempt falls back to the CPU per video.
# MEDIA_HWACCEL=auto
# MEDIA_VAAPI_DEVICE=/dev/dri/renderD128

APP_NAME=Flimm
PORT=8080
SENTRY_DSN=
LOG_LEVEL=info
