// Copy this file to Secrets.xcconfig (gitignored) and fill in your values.
// The example values are enough to compile — CI copies this file verbatim.

// Apple Developer Program team id, used for signing. Leave empty for an
// unsigned simulator build; TestFlight archives need the real one.
DEVELOPMENT_TEAM =

// Sentry crash reporting (Project Settings -> Client Keys). Optional: leave
// empty to disable Sentry entirely — debug builds never start it anyway.
//
// Note the $() in the URL: xcconfig treats // as a comment, so the slashes
// must be split. A real value looks like
// https:/$()/PUBLIC_KEY@o0.ingest.sentry.io/0
SENTRY_DSN =

// Self-hosted Umami analytics. Optional: leave either empty to ship without
// analytics — debug builds never report anyway, and a Flimm server running
// ANALYTICS_DISABLED=true switches it off for the app pointed at it.
//
// Same // gotcha as the DSN above: https:/$()/stats.example.com
UMAMI_URL =
UMAMI_WEBSITE_ID =
