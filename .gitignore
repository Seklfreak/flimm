frontend/node_modules/
frontend/dist/*
!frontend/dist/index.html
frontend/tsconfig.tsbuildinfo
bin/
*.log
.env

# Apple apps (apple/) — the .xcodeproj is generated by xcodegen, and the
# xcconfig holds real signing/Sentry values.
apple/*.xcodeproj/
apple/Config/Secrets.xcconfig
apple/*/Info.plist
apple/**/.build/
apple/**/DerivedData/
apple/**/xcuserdata/
.DS_Store
